@page "/editor"
@rendermode InteractiveServer
@inject SaveFileService SaveService
@inject FileDialogService FileDialog

<PageTitle>Editor - Witcher 2 Save Editor</PageTitle>

<h1>Save File Editor</h1>

@if (!SaveService.IsLoaded)
{
    <div class="mt-3">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Load Save File</h5>
                <p>Select a Witcher 2 save file (.sav) to edit:</p>
                <button class="btn btn-primary" @onclick="OpenFile" disabled="@isLoading">
                    📂 Browse for .sav file...
                </button>
                @if (isLoading)
                {
                    <div class="mt-2">
                        <div class="spinner-border spinner-border-sm" role="status"></div>
                        <span class="ms-2">Loading...</span>
                    </div>
                }
            </div>
        </div>
    </div>
}
else
{
    <div class="d-flex justify-content-between align-items-center mt-2 mb-3">
        <div>
            <span class="badge bg-success me-2">Loaded</span>
            <strong>@SaveService.CurrentFileName</strong>
            <span class="text-muted ms-2">
                (@FormatBytes(SaveService.CurrentSave!.RawDecompressedData.Length))
            </span>
        </div>
        <div>
            <button class="btn btn-success btn-sm me-2" @onclick="SaveFile">
                💾 Save
            </button>
            <button class="btn btn-primary btn-sm me-2" @onclick="SaveFileAs">
                💾 Save As...
            </button>
            <button class="btn btn-outline-secondary btn-sm" @onclick="CloseSave">
                ✕ Close
            </button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(statusMessage))
    {
        <div class="alert @statusClass alert-dismissible fade show py-2" role="alert">
            @statusMessage
            <button type="button" class="btn-close btn-close-sm" @onclick="() => statusMessage = null"></button>
        </div>
    }

    <!-- Tabs -->
    <ul class="nav nav-tabs">
        <li class="nav-item">
            <button class="nav-link @(activeTab == "inventory" ? "active" : "")" @onclick='() => activeTab = "inventory"'>
                🎒 Inventory
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link @(activeTab == "quests" ? "active" : "")" @onclick='() => activeTab = "quests"'>
                📜 Quests
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link @(activeTab == "facts" ? "active" : "")" @onclick='() => activeTab = "facts"'>
                🔑 Story Flags
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link @(activeTab == "search" ? "active" : "")" @onclick='() => activeTab = "search"'>
                🔍 Search
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link @(activeTab == "raw" ? "active" : "")" @onclick='() => activeTab = "raw"'>
                🗂 Raw Sections
            </button>
        </li>
    </ul>

    <div class="tab-content border border-top-0 p-3">
        @if (activeTab == "inventory")
        {
            <InventoryTab Save="SaveService.CurrentSave!" OnStatusMessage="SetStatus" />
        }
        else if (activeTab == "quests")
        {
            <QuestsTab Save="SaveService.CurrentSave!" />
        }
        else if (activeTab == "facts")
        {
            <FactsTab Save="SaveService.CurrentSave!" OnStatusMessage="SetStatus" />
        }
        else if (activeTab == "search")
        {
            <SearchTab Save="SaveService.CurrentSave!" OnStatusMessage="SetStatus" />
        }
        else if (activeTab == "raw")
        {
            <RawSectionsTab Save="SaveService.CurrentSave!" OnStatusMessage="SetStatus" />
        }
    </div>
}

@if (!string.IsNullOrEmpty(SaveService.ErrorMessage))
{
    <div class="alert alert-danger mt-3">@SaveService.ErrorMessage</div>
}

@code {
    private bool isLoading;
    private string activeTab = "inventory";
    private string? statusMessage;
    private string statusClass = "alert-info";

    private async Task OpenFile()
    {
        var path = await FileDialog.PickSaveFileAsync();
        if (path == null) return;

        isLoading = true;
        StateHasChanged();

        try
        {
            await SaveService.LoadFromPathAsync(path);
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void SetStatus((string message, bool success) s)
    {
        statusMessage = s.message;
        statusClass = s.success ? "alert-success" : "alert-warning";
        StateHasChanged();
    }

    private async Task SaveFile()
    {
        var success = await SaveService.SaveAsync();
        statusMessage = success ? "Saved successfully!" : "Save failed.";
        statusClass = success ? "alert-success" : "alert-danger";
    }

    private async Task SaveFileAs()
    {
        var path = await FileDialog.PickSaveLocationAsync(SaveService.CurrentFileName ?? "modified.sav");
        if (path == null) return;

        var success = await SaveService.SaveToPathAsync(path);
        statusMessage = success ? $"Saved to {path}" : "Save failed.";
        statusClass = success ? "alert-success" : "alert-danger";
    }

    private void CloseSave()
    {
        activeTab = "inventory";
        statusMessage = null;
        SaveService.Close();
    }

    private static string FormatBytes(long bytes)
    {
        if (bytes < 1024) return $"{bytes} B";
        if (bytes < 1024 * 1024) return $"{bytes / 1024.0:F1} KB";
        return $"{bytes / (1024.0 * 1024.0):F1} MB";
    }
}
