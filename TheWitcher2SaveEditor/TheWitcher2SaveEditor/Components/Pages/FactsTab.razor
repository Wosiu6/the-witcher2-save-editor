@using TheWitcher2SaveEditor.Models

<section class="panel-card">
    <div class="panel-header">
        <div>
            <p class="panel-kicker">Story Flags</p>
            <h3>Facts and decisions</h3>
        </div>
    </div>

    @if (facts.Count == 0)
    {
        <p class="support-copy">No facts/story flags found.</p>
    }
    else
    {
        <div style="margin-bottom:14px">
            <input class="editor-input" placeholder="Search facts..." @bind="filter" @bind:event="oninput" />
        </div>

        <div class="table-shell">
            <table class="editor-table">
                <thead>
                    <tr>
                        <th>Fact ID</th>
                        <th>Entries</th>
                        <th>Expiring</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var fact in FilteredFacts)
                    {
                        <tr>
                            <td>
                                <code>@fact.Id</code>
                                @if (fact.Id.Contains("Choice", StringComparison.OrdinalIgnoreCase))
                                {
                                    <span class="badge badge-warning" style="margin-left:8px">Decision</span>
                                }
                            </td>
                            <td>@fact.EntryCount</td>
                            <td>@fact.ExpiringCount</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <p class="support-copy" style="margin-top:10px">Total: @facts.Count facts, showing @FilteredFacts.Count()</p>
    }
</section>

@code {
    [Parameter] public required W2SaveFile Save { get; set; }
    [Parameter] public EventCallback<(string message, bool success)> OnStatusMessage { get; set; }

    private List<FactVm> facts = [];
    private string filter = "";

    private IEnumerable<FactVm> FilteredFacts =>
        string.IsNullOrWhiteSpace(filter)
            ? facts
            : facts.Where(f => f.Id.Contains(filter, StringComparison.OrdinalIgnoreCase));

    protected override void OnParametersSet()
    {
        facts.Clear();
        var section = Save.Sections.FirstOrDefault(s => s.Name == "facts");
        if (section?.RootNode == null) return;

        foreach (var child in section.RootNode.Children.Where(c => c.Name == "fact" && c.NodeType == "BLCK"))
        {
            var idNode = child.Children.FirstOrDefault(c => c.Name == "id");
            var entryCountNode = child.Children.FirstOrDefault(c => c.Name == "entryCount");
            var expiringNode = child.Children.FirstOrDefault(c => c.Name == "expiringCount");

            facts.Add(new FactVm
            {
                Id = idNode?.Value?.DisplayValue ?? "Unknown",
                EntryCount = entryCountNode?.Value?.Value as uint? ?? 0,
                ExpiringCount = expiringNode?.Value?.Value as uint? ?? 0
            });
        }
    }

    private class FactVm
    {
        public string Id { get; set; } = "";
        public uint EntryCount { get; set; }
        public uint ExpiringCount { get; set; }
    }
}
