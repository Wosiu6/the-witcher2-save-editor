@using TheWitcher2SaveEditor.Models
@using TheWitcher2SaveEditor.Services

<section class="panel-card">
    <div class="panel-header">
        <div>
            <p class="panel-kicker">Inventory</p>
            <h3>Manage carried items</h3>
        </div>
    </div>

    @if (inventoryItems.Count == 0)
    {
        <p class="support-copy">No inventory data found in this save file.</p>
    }
    else
    {
        <div class="inline-form" style="margin-bottom:14px">
            <input class="editor-input" placeholder="Filter items..." @bind="filter" @bind:event="oninput" />
        </div>

        <div class="table-shell">
            <table class="editor-table">
                <thead>
                    <tr>
                        <th>Item Name</th>
                        <th>Qty</th>
                        <th>Flags</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in FilteredItems)
                    {
                        <tr>
                            <td>
                                <span class="@(item.Flags >= 16 ? "item-equipped" : "")">@item.Name</span>
                            </td>
                            <td>
                                @if (editingItem == item)
                                {
                                    <input class="editor-input editor-input-mini" type="number"
                                           @bind="editQty" @onkeydown="HandleKey" />
                                }
                                else
                                {
                                    @item.Quantity
                                }
                            </td>
                            <td><span class="badge badge-muted">@item.Flags</span></td>
                            <td class="table-actions">
                                @if (editingItem == item)
                                {
                                    <button class="mini-button" @onclick="SaveEdit">Apply</button>
                                    <button class="mini-button" @onclick="CancelEdit">Cancel</button>
                                }
                                else
                                {
                                    <button class="mini-button" @onclick="() => StartEdit(item)">Edit</button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <p class="support-copy" style="margin-top:10px">Showing @FilteredItems.Count() of @inventoryItems.Count items. Equipped items (flags >= 16) are highlighted.</p>
    }
</section>

@code {
    [Parameter] public required W2SaveFile Save { get; set; }
    [Parameter] public EventCallback<(string message, bool success)> OnStatusMessage { get; set; }

    private List<InventoryItemVm> inventoryItems = [];
    private string filter = "";
    private InventoryItemVm? editingItem;
    private uint editQty;

    private IEnumerable<InventoryItemVm> FilteredItems =>
        string.IsNullOrWhiteSpace(filter)
            ? inventoryItems
            : inventoryItems.Where(i => i.Name.Contains(filter, StringComparison.OrdinalIgnoreCase));

    protected override void OnParametersSet()
    {
        inventoryItems.Clear();
        var section = Save.Sections.FirstOrDefault(s => s.Name == "dynamicEntities");
        if (section?.RootNode == null) return;
        FindInventories(section.RootNode, true);
    }

    private void FindInventories(SaveNode node, bool playerOnly)
    {
        if (node.Name == "inventory" && node.NodeType == "BLCK")
        {
            var itemCountNode = node.Children.FirstOrDefault(c => c.Name == "itemCount");
            var count = itemCountNode?.Value?.Value as uint? ?? 0;

            if (!playerOnly || count >= 10)
            {
                foreach (var item in node.Children.Where(c => c.Name == "item"))
                {
                    var nameNode = item.Children.FirstOrDefault(c => c.Name == "name");
                    var qtyNode = item.Children.FirstOrDefault(c => c.Name == "quantity");
                    var flagsNode = item.Children.FirstOrDefault(c => c.Name == "flags");

                    if (nameNode?.Value != null)
                    {
                        inventoryItems.Add(new InventoryItemVm
                        {
                            Name = nameNode.Value.DisplayValue,
                            Quantity = qtyNode?.Value?.Value as uint? ?? 1,
                            Flags = flagsNode?.Value?.Value as ushort? ?? 0,
                            QuantityNode = qtyNode,
                            Section = Save.Sections.First(s => s.Name == "dynamicEntities")
                        });
                    }
                }
                if (playerOnly && inventoryItems.Count > 0) return;
            }
        }

        foreach (var c in node.Children)
        {
            FindInventories(c, playerOnly);
            if (playerOnly && inventoryItems.Count > 0) return;
        }
    }

    private void StartEdit(InventoryItemVm item)
    {
        editingItem = item;
        editQty = item.Quantity;
    }

    private async Task SaveEdit()
    {
        if (editingItem?.QuantityNode?.Value == null) return;

        var oldBytes = editingItem.QuantityNode.Value.RawBytes;
        var newBytes = BitConverter.GetBytes(editQty);

        if (oldBytes.Length == newBytes.Length)
        {
            var data = Save.RawDecompressedData;
            var section = editingItem.Section;
            int nextOffset = Save.Sections.Where(s => s.Offset > section.Offset).Select(s => s.Offset).DefaultIfEmpty(data.Length).Min();

            for (int i = section.Offset; i < nextOffset - oldBytes.Length; i++)
            {
                bool match = true;
                for (int j = 0; j < oldBytes.Length; j++)
                {
                    if (data[i + j] != oldBytes[j]) { match = false; break; }
                }
                if (match)
                {
                    Array.Copy(newBytes, 0, data, i, newBytes.Length);
                    editingItem.QuantityNode.Value.RawBytes = newBytes;
                    editingItem.QuantityNode.Value.Value = editQty;
                    editingItem.Quantity = editQty;
                    await OnStatusMessage.InvokeAsync(($"Updated {editingItem.Name} quantity to {editQty}", true));
                    break;
                }
            }
        }

        editingItem = null;
    }

    private void CancelEdit() => editingItem = null;

    private async Task HandleKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await SaveEdit();
        if (e.Key == "Escape") CancelEdit();
    }

    private class InventoryItemVm
    {
        public string Name { get; set; } = "";
        public uint Quantity { get; set; }
        public ushort Flags { get; set; }
        public SaveNode? QuantityNode { get; set; }
        public SaveSection Section { get; set; } = null!;
    }
}
