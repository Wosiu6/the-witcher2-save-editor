@using TheWitcher2SaveEditor.Models

<h5>📜 Quest System</h5>
<p class="text-muted small">View active quests, quest files, and quest blocks.</p>

@if (quests.Count == 0)
{
    <div class="alert alert-info">No quest data found.</div>
}
else
{
    <div class="mb-3">
        <input type="text" class="form-control" placeholder="Filter quests..." @bind="filter" @bind:event="oninput" />
    </div>

    @foreach (var quest in FilteredQuests)
    {
        <div class="card mb-2">
            <div class="card-header py-2 d-flex justify-content-between align-items-center" style="cursor:pointer"
                 @onclick="() => quest.IsExpanded = !quest.IsExpanded">
                <div>
                    <span class="me-1">@(quest.IsExpanded ? "▼" : "▶")</span>
                    <strong>@quest.DisplayName</strong>
                </div>
                <span class="badge bg-info">@quest.Blocks.Count blocks</span>
            </div>
            @if (quest.IsExpanded)
            {
                <div class="card-body py-2">
                    <p class="text-muted small mb-2">File: <code>@quest.FileName</code></p>

                    @if (quest.Threads.Count > 0)
                    {
                        @foreach (var thread in quest.Threads)
                        {
                            <div class="mb-2">
                                <strong class="small">Thread: @thread.Name</strong>
                                <span class="text-muted small">(Blocks: @thread.NumBlocks)</span>
                                <table class="table table-sm table-bordered mt-1 mb-0">
                                    <thead>
                                        <tr class="small">
                                            <th>Block</th>
                                            <th>Status</th>
                                            <th>GUID</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var block in thread.Blocks)
                                        {
                                            <tr class="small">
                                                <td>@block.Name</td>
                                                <td>
                                                    <span class="badge @(block.IsActive ? "bg-success" : "bg-secondary")">
                                                        @(block.IsActive ? "Active" : "Inactive")
                                                    </span>
                                                </td>
                                                <td class="font-monospace text-muted" style="font-size:0.7rem">@block.Guid</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    }
                </div>
            }
        </div>
    }
}

@code {
    [Parameter] public required W2SaveFile Save { get; set; }

    private List<QuestVm> quests = [];
    private string filter = "";

    private IEnumerable<QuestVm> FilteredQuests =>
        string.IsNullOrWhiteSpace(filter)
            ? quests
            : quests.Where(q => q.FileName.Contains(filter, StringComparison.OrdinalIgnoreCase)
                             || q.DisplayName.Contains(filter, StringComparison.OrdinalIgnoreCase));

    protected override void OnParametersSet()
    {
        quests.Clear();
        var section = Save.Sections.FirstOrDefault(s => s.Name == "questSystem");
        if (section?.RootNode == null) return;

        ParseQuests(section.RootNode);
    }

    private void ParseQuests(SaveNode root)
    {
        foreach (var child in root.Children.Where(c => c.Name == "quest" && c.NodeType == "BLCK"))
        {
            var fileNameNode = child.Children.FirstOrDefault(c => c.Name == "fileName");
            var fileName = fileNameNode?.Value?.DisplayValue ?? "Unknown";

            var quest = new QuestVm
            {
                FileName = fileName,
                DisplayName = ExtractDisplayName(fileName)
            };

            // Parse threads
            foreach (var threadNode in child.Children.Where(c => c.Name == "questThread" && c.NodeType == "BLCK"))
            {
                var thread = new QuestThreadVm { Name = "questThread" };
                var numBlocks = threadNode.Children.FirstOrDefault(c => c.Name == "numBlocks");
                thread.NumBlocks = numBlocks?.Value?.Value as uint? ?? 0;

                foreach (var blockNode in threadNode.Children.Where(c => c.Name == "questBlock" && c.NodeType == "BLCK"))
                {
                    var block = new QuestBlockVm();
                    var guidNode = blockNode.Children.FirstOrDefault(c => c.Name == "guid");
                    var activeNode = blockNode.Children.FirstOrDefault(c => c.Name == "activated");

                    block.Guid = guidNode?.Value?.DisplayValue ?? "";
                    block.IsActive = activeNode?.Value?.Value is true;
                    block.Name = $"Block {thread.Blocks.Count + 1}";

                    thread.Blocks.Add(block);
                }

                quest.Threads.Add(thread);
            }

            quest.Blocks = quest.Threads.SelectMany(t => t.Blocks).ToList();
            quests.Add(quest);
        }
    }

    private static string ExtractDisplayName(string fileName)
    {
        // e.g. "game\0_prologue\00_prologue.w2quest" -> "Prologue"
        var name = Path.GetFileNameWithoutExtension(fileName);
        if (name.Contains('_'))
        {
            var parts = name.Split('_', StringSplitOptions.RemoveEmptyEntries);
            // Remove numeric prefixes
            var meaningful = parts.Where(p => !int.TryParse(p, out _)).ToArray();
            if (meaningful.Length > 0)
                return string.Join(" ", meaningful.Select(p => char.ToUpper(p[0]) + p[1..]));
        }
        return name;
    }

    private class QuestVm
    {
        public string FileName { get; set; } = "";
        public string DisplayName { get; set; } = "";
        public List<QuestThreadVm> Threads { get; set; } = [];
        public List<QuestBlockVm> Blocks { get; set; } = [];
        public bool IsExpanded { get; set; }
    }

    private class QuestThreadVm
    {
        public string Name { get; set; } = "";
        public uint NumBlocks { get; set; }
        public List<QuestBlockVm> Blocks { get; set; } = [];
    }

    private class QuestBlockVm
    {
        public string Name { get; set; } = "";
        public string Guid { get; set; } = "";
        public bool IsActive { get; set; }
    }
}
