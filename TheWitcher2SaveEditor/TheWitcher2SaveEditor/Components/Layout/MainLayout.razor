@inherits LayoutComponentBase

<div class="shell">
    <header class="shell-header">
        <div>
            <p class="shell-kicker">Save Editor</p>
            <h1>The Witcher 2 Save Editor</h1>
        </div>
        <p class="shell-caption">Edit your Assassins of Kings saves — inventory, quests, facts, and more.</p>
    </header>

    <main class="shell-main">
        @Body
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">x</span>
</div>
